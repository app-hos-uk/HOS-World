# Staging environment overrides for Railway (@hos-marketplace/api + @hos-marketplace/web)
# Copy values into Railway Dashboard → staging environment → Variables
# Generate secrets: ./services/api/scripts/generate-jwt-secrets.sh
#                   openssl rand -hex 32  (for INTEGRATION_ENCRYPTION_KEY, ENCRYPTION_KEY)

# --- Core ---
NODE_ENV=staging

# --- Money / external write gates (keep OFF until QA explicitly enables) ---
POS_ENABLED=false
FF_POS_INTEGRATION=false
LOYALTY_POS_VOUCHER_ENABLED=false
ACCOUNTING_ENABLED=false
FF_ACCOUNTING_XERO=false
POS_GIFT_CARD_MIN_AMOUNT=1
POS_GIFT_CARD_MAX_AMOUNT=500

# --- Auth (generate fresh — never copy from production) ---
# JWT_SECRET=
# JWT_REFRESH_SECRET=
# INTEGRATION_ENCRYPTION_KEY=
# ENCRYPTION_KEY=

# --- Stripe (test mode only) ---
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- URLs (set after first staging deploy — Railway public domains) ---
# API service (@hos-marketplace/api):
FRONTEND_URL=https://YOUR-STAGING-WEB.up.railway.app
CORS_ALLOWED_ORIGINS=https://YOUR-STAGING-WEB.up.railway.app

# Web service (@hos-marketplace/web) — build-time NEXT_PUBLIC_* vars:
NEXT_PUBLIC_API_URL=https://YOUR-STAGING-API.up.railway.app/api
NEXT_PUBLIC_SITE_URL=https://YOUR-STAGING-WEB.up.railway.app
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Runtime server-side proxy (Railway private networking if available):
# API_INTERNAL_URL=http://@hos-marketplace-api.railway.internal:3001

# --- QA seed endpoints (staging only) ---
# DEV_SEED_SECRET=generate-a-long-random-string
# SEED_ADMIN_PASSWORD=set-for-admin-bootstrap
# TEST_SEED_PASSWORD=set-for-hos.test-users
