{
  "name": "hos-marketplace",
  "version": "1.0.0",
  "description": "House of Spells Marketplace - Scalable e-commerce platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/api"
  ],
  "scripts": {
    "prepare": "node scripts/setup-git-hooks.mjs",
    "dev": "turbo run dev --filter=@hos-marketplace/api --filter=@hos-marketplace/web --concurrency=5",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "turbo run type-check",
    "fix:pnpm-state": "rm -f node_modules/.pnpm-workspace-state-v1.json && pnpm install",
    "verify:api": "node scripts/verify-api-endpoints.mjs"
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.11.13",
    "prettier": "^3.9.6",
    "turbo": "^1.11.2",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "overrides": {
      "axios": ">=1.18.1",
      "fast-xml-parser": ">=5.2.5",
      "body-parser": ">=1.20.3",
      "brace-expansion@1": ">=2.1.4",
      "brace-expansion@2": ">=2.1.4",
      "defu": ">=6.1.5",
      "effect": ">=3.20.0",
      "fast-xml-builder": ">=1.1.7",
      "form-data": ">=4.0.6",
      "js-yaml@4": ">=4.3.1",
      "lodash": ">=4.18.0",
      "minimatch@3": ">=3.1.4",
      "minimatch@5": ">=5.1.8",
      "minimatch@9": ">=9.0.7",
      "multer": ">=2.2.0",
      "nanoid@3": ">=3.3.18",
      "nodemailer": ">=7.0.11",
      "path-to-regexp@0": ">=0.1.13",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0",
      "tmp": ">=0.2.6"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}