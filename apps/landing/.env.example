# House of Spells Landing Page
# Copy to .env.local for local development

# API URL for founding member registration
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Production: NEXT_PUBLIC_API_URL=https://api.houseofspells.com/api

# Canonical site URL (used for OG images, JSON-LD, canonical links)
# MUST be set in production — otherwise og:image points to localhost
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# Production US:  NEXT_PUBLIC_SITE_URL=https://us.houseofspells.com
# Production MY:  NEXT_PUBLIC_SITE_URL=https://houseofspells.my
# Production Hub: NEXT_PUBLIC_SITE_URL=https://houseofspells.com

# Shop URL (set when e-commerce is live; shows "Enter Shop" link in nav)
# Production US: NEXT_PUBLIC_SHOP_URL=https://shop.houseofspells.com
# Production MY: NEXT_PUBLIC_SHOP_URL=https://shop.houseofspells.my

# Analytics — Google Analytics 4 measurement ID
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Analytics — Meta (Facebook) Pixel ID
# NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# Market configuration
NEXT_PUBLIC_MARKET_CODE=US
# NEXT_PUBLIC_MARKET_CODE=MY

# Site role — set to "hub" for the global country picker (houseofspells.com).
# Leave unset or omit for country-specific landing sites (US, MY, etc.).
# NEXT_PUBLIC_SITE_ROLE=hub
